DATABASE_URL=postgresql+psycopg2://user:password@host:5432/railway
CMC_API_KEY=
COINGECKO_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# Random long string used to sign session cookies. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# How often (hours) to re-alert on a still-open, unmuted gap.
GAP_REMINDER_INTERVAL_HOURS=24

# MarketUniverseProvider (app/criteria/market_universe.py): auto-tracks the
# top-N CMC coins by market cap, plus any CMC-listed coin also on Binance
# Spot. Off by default -- the manual list (config/projects.yaml) keeps
# working either way; this adds to it, doesn't replace it.
MARKET_UNIVERSE_ENABLED=false
MARKET_UNIVERSE_TOP_N=600
